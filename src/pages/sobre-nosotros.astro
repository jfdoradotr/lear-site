---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sobre Nosotros - LEAR" description="Conoce más sobre LEAR, nuestros valores y misión">
  <!-- Page Header -->
  <section class="relative py-20 bg-gradient-to-br from-lear-primary via-lear-primary-light to-lear-secondary text-white overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute -top-20 -right-10 w-80 h-80 bg-lear-secondary rounded-full blur-3xl"></div>
      <div class="absolute -bottom-24 -left-10 w-96 h-96 bg-lear-accent rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="inline-flex items-center gap-2 px-6 py-3 bg-white/10 backdrop-blur-sm rounded-full font-semibold text-sm mb-6 border border-white/20">
        <div class="w-2 h-2 bg-lear-secondary rounded-full animate-pulse"></div>
        SOBRE NOSOTROS
      </div>
      <h1 class="text-4xl md:text-6xl font-black mb-4">Nuestra historia y propósito</h1>
      <p class="text-xl md:text-2xl text-white/90 max-w-2xl">
        Conoce el camino que nos trajo hasta aquí y lo que nos impulsa cada día.
      </p>
    </div>
  </section>

  <!-- Founder & Story -->
  <section class="relative py-24 bg-white overflow-hidden">
    <!-- Decorative background -->
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-lear-secondary/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-lear-accent/5 rounded-full blur-3xl"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Photo -->
        <div class="relative">
          <!-- Decorative offset frame -->
          <div class="absolute -inset-4 bg-gradient-to-br from-lear-primary/20 via-lear-secondary/20 to-lear-accent/20 rounded-[2.5rem] blur-2xl"></div>
          <div class="absolute -top-3 -left-3 w-full h-full bg-gradient-to-br from-lear-secondary to-lear-accent rounded-3xl"></div>
          <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white">
            <img
              src="/images/team/elena-fundadora.jpg"
              alt="Laura Elena Alemán Román, fundadora de LEAR"
              class="w-full h-auto object-cover"
              loading="lazy"
            />
          </div>
          <!-- Floating signature badge -->
          <div class="absolute -bottom-5 left-1/2 -translate-x-1/2 md:left-auto md:-right-4 md:translate-x-0 bg-white rounded-2xl shadow-xl px-5 py-3 border border-lear-gray-100 flex items-center gap-3">
            <div class="w-2 h-10 bg-gradient-to-b from-lear-primary to-lear-secondary rounded-full"></div>
            <div>
              <p class="text-xs font-bold text-lear-secondary uppercase tracking-wide">Fundadora</p>
              <p class="text-sm font-black text-lear-gray-900">Laura Elena Alemán Román</p>
            </div>
          </div>
        </div>

        <!-- Text -->
        <div>
          <div class="inline-flex items-center gap-2 px-5 py-2 bg-gradient-to-r from-lear-primary/10 to-lear-secondary/10 rounded-full font-bold text-xs md:text-sm mb-6 border border-lear-primary/20">
            <div class="w-2 h-2 bg-lear-primary rounded-full animate-pulse"></div>
            NUESTRA HISTORIA
          </div>
          <h2 class="text-3xl md:text-5xl font-black text-lear-gray-900 mb-6 leading-tight">
            Conoce a <span class="bg-gradient-to-r from-lear-primary to-lear-secondary bg-clip-text text-transparent">Laura Elena Alemán Román</span>
          </h2>
          <p class="text-lg text-lear-gray-600 mb-5 leading-relaxed">
            LEAR nace de la visión de Laura Elena, fisioterapeuta detrás de lo que originalmente conociste
            como <strong>Fisio con Elena</strong>. Lo que empezó como una consulta personal se transformó
            en un centro integral de fisioterapia y rehabilitación que combina experiencia profesional con
            un enfoque cercano y personalizado.
          </p>
          <p class="text-lg text-lear-gray-600 mb-5 leading-relaxed">
            Su compromiso es claro: acompañar a cada paciente con las herramientas y el cuidado necesarios
            para alcanzar sus objetivos de salud y bienestar —ya sea recuperándose de una lesión, mejorando
            su condición física o previniendo futuras complicaciones.
          </p>
          <p class="text-lg text-lear-gray-600 leading-relaxed">
            Hoy, LEAR es un equipo de profesionales que comparte esa misma visión y atiende cada caso
            con la misma cercanía con la que Elena empezó.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission & Vision -->
  <section class="py-20 bg-lear-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12">
        <!-- Mission -->
        <div class="bg-white rounded-3xl p-8 shadow-xl border border-lear-gray-100">
          <div class="inline-block p-3 bg-lear-primary/10 rounded-lg mb-4">
            <svg class="w-8 h-8 text-lear-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-lear-gray-900 mb-4">Nuestra Misión</h2>
          <p class="text-lear-gray-600 leading-relaxed">
            Proporcionar servicios de fisioterapia y rehabilitación de excelencia, utilizando
            técnicas actualizadas y un enfoque personalizado que priorice el bienestar integral
            de cada paciente, ayudándoles a alcanzar sus objetivos de salud y calidad de vida.
          </p>
        </div>

        <!-- Vision -->
        <div class="bg-white rounded-3xl p-8 shadow-xl border border-lear-gray-100">
          <div class="inline-block p-3 bg-lear-secondary/10 rounded-lg mb-4">
            <svg class="w-8 h-8 text-lear-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-lear-gray-900 mb-4">Nuestra Visión</h2>
          <p class="text-lear-gray-600 leading-relaxed">
            Ser reconocidos como un centro de referencia en fisioterapia y rehabilitación integral,
            destacándonos por nuestro profesionalismo, innovación en tratamientos y el compromiso
            genuino con la recuperación y bienestar de nuestros pacientes.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-lear-gray-900 mb-4">
          Nuestros Valores
        </h2>
        <p class="text-lg text-lear-gray-600 max-w-2xl mx-auto">
          Los principios que guían nuestro trabajo diario.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Value 1 -->
        <div class="text-center bg-lear-bg-primary rounded-3xl p-8 shadow-md border border-lear-gray-100">
          <div class="inline-block p-4 bg-lear-primary/10 rounded-full mb-4">
            <svg class="w-8 h-8 text-lear-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-lear-gray-900 mb-2">Compromiso</h3>
          <p class="text-lear-gray-600">
            Dedicación total a la recuperación y bienestar de nuestros pacientes.
          </p>
        </div>

        <!-- Value 2 -->
        <div class="text-center bg-lear-bg-primary rounded-3xl p-8 shadow-md border border-lear-gray-100">
          <div class="inline-block p-4 bg-lear-primary/10 rounded-full mb-4">
            <svg class="w-8 h-8 text-lear-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-lear-gray-900 mb-2">Profesionalismo</h3>
          <p class="text-lear-gray-600">
            Excelencia en cada tratamiento y atención brindada.
          </p>
        </div>

        <!-- Value 3 -->
        <div class="text-center bg-lear-bg-primary rounded-3xl p-8 shadow-md border border-lear-gray-100">
          <div class="inline-block p-4 bg-lear-primary/10 rounded-full mb-4">
            <svg class="w-8 h-8 text-lear-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-lear-gray-900 mb-2">Personalización</h3>
          <p class="text-lear-gray-600">
            Tratamientos adaptados a las necesidades únicas de cada persona.
          </p>
        </div>

        <!-- Value 4 -->
        <div class="text-center bg-lear-bg-primary rounded-3xl p-8 shadow-md border border-lear-gray-100">
          <div class="inline-block p-4 bg-lear-primary/10 rounded-full mb-4">
            <svg class="w-8 h-8 text-lear-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-lear-gray-900 mb-2">Innovación</h3>
          <p class="text-lear-gray-600">
            Actualización constante con las mejores prácticas y técnicas.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What Makes Us Different -->
  <section class="py-20 bg-gradient-to-br from-lear-bg-primary to-lear-bg-secondary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-lear-gray-900 mb-4">
          ¿Qué nos hace diferentes?
        </h2>
      </div>

      <div class="space-y-6">
        <div class="bg-white rounded-2xl p-6 shadow-md border border-lear-gray-100">
          <div class="flex items-start">
            <div class="flex-shrink-0">
              <div class="p-2 bg-lear-primary/10 rounded-lg">
                <svg class="w-6 h-6 text-lear-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
            </div>
            <div class="ml-4">
              <h3 class="text-lg font-semibold text-lear-gray-900 mb-2">Enfoque Integral</h3>
              <p class="text-lear-gray-600">
                No solo tratamos síntomas, abordamos la causa raíz del problema para una recuperación completa y duradera.
              </p>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-md border border-lear-gray-100">
          <div class="flex items-start">
            <div class="flex-shrink-0">
              <div class="p-2 bg-lear-primary/10 rounded-lg">
                <svg class="w-6 h-6 text-lear-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
            </div>
            <div class="ml-4">
              <h3 class="text-lg font-semibold text-lear-gray-900 mb-2">Atención Personalizada</h3>
              <p class="text-lear-gray-600">
                Cada paciente recibe un plan de tratamiento diseñado específicamente para sus necesidades y objetivos.
              </p>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-md border border-lear-gray-100">
          <div class="flex items-start">
            <div class="flex-shrink-0">
              <div class="p-2 bg-lear-primary/10 rounded-lg">
                <svg class="w-6 h-6 text-lear-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
            </div>
            <div class="ml-4">
              <h3 class="text-lg font-semibold text-lear-gray-900 mb-2">Equipo Multidisciplinario</h3>
              <p class="text-lear-gray-600">
                Combinamos la experiencia de fisioterapeutas y entrenadores personales para un servicio completo.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="relative py-20 bg-gradient-to-br from-lear-primary via-lear-primary-dark to-lear-secondary text-white overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute top-0 left-1/4 w-80 h-80 bg-lear-secondary rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 right-1/4 w-80 h-80 bg-lear-accent rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold mb-4">
        ¿Quieres ser parte de nuestra historia de éxito?
      </h2>
      <p class="text-xl text-white/90 mb-8">
        Visítanos o contáctanos para comenzar tu camino hacia una mejor salud.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href="https://wa.me/5218717558798?text=Hola%2C%20me%20gustar%C3%ADa%20saber%20m%C3%A1s%20sobre%20LEAR"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-3 bg-[#25D366] hover:bg-[#20BA5A] text-white px-8 py-4 rounded-2xl font-bold text-lg shadow-2xl hover:shadow-[0_20px_60px_rgba(37,211,102,0.4)] transition-all duration-300 hover:scale-110"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          <span>Contáctanos por WhatsApp</span>
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
