---
import Layout from '../layouts/Layout.astro';
import { hours, address, addressText, phoneDisplay, phoneTel, whatsappNumber } from '../data/business';

const addressLines = [
  address.street,
  address.neighborhood,
  `${address.postalCode} ${address.city}, ${address.stateShort}`
];

// Ojo: la URL conserva "Juarez" sin acento porque así está registrado el lugar
// en Google Maps. Cambiarlo rompería el enlace.
const mapsUrl = 'https://www.google.com/maps/search/?api=1&query=Av.%20Juarez%20368%2C%20Primero%20de%20Cobi%C3%A1n%20Centro%2C%2027000%20Torre%C3%B3n%2C%20Coah.';
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=Hola%2C%20me%20gustar%C3%ADa%20agendar%20una%20cita`;
---

<Layout
  title="Horarios y Ubicación | LEAR Fisioterapia Torreón"
  description="Estamos en Av. Juárez 368, Centro, Torreón. Consulta nuestros horarios de atención, llámanos o escríbenos por WhatsApp para agendar tu cita."
>
  <section class="relative py-20 bg-lear-bg-primary overflow-hidden">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-lear-primary/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-lear-secondary/5 rounded-full blur-3xl"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-lear-primary/10 to-lear-secondary/10 backdrop-blur-sm rounded-full font-semibold text-sm mb-6 border border-lear-primary/20">
          <div class="w-2 h-2 bg-lear-primary rounded-full animate-pulse"></div>
          VISÍTANOS
        </div>
        <h1 class="text-4xl md:text-5xl font-black text-lear-gray-900 mb-4">
          Horarios y <span class="bg-gradient-to-r from-lear-primary to-lear-secondary bg-clip-text text-transparent">Ubicación</span>
        </h1>
        <p class="text-lg text-lear-gray-600 max-w-2xl mx-auto">
          Estamos en el Centro de Torreón, Coahuila. Encuentra la dirección exacta, nuestros horarios
          de atención y comparte la ubicación en segundos.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- Horario -->
        <div class="bg-white rounded-3xl p-8 shadow-xl border border-lear-gray-100">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-16 h-16 bg-gradient-to-br from-lear-primary to-lear-secondary rounded-2xl flex items-center justify-center shadow-lg">
              <svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h2 class="text-2xl font-bold text-lear-gray-900">Horario de Atención</h2>
          </div>
          <div class="space-y-4">
            {hours.map((block, index) => (
              <div class={`flex items-center justify-between py-3${index < hours.length - 1 ? ' border-b border-lear-gray-100' : ''}`}>
                <span class="font-semibold text-lear-gray-900">{block.label}</span>
                <div class="text-right">
                  {block.slots.map((slot) => <p class="text-lear-gray-700">{slot}</p>)}
                </div>
              </div>
            ))}
            <div class="mt-6 pt-6 border-t border-lear-gray-200">
              <p class="text-sm text-lear-gray-500 flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
                Cerrado los domingos y lunes
              </p>
            </div>
          </div>
        </div>

        <!-- Ubicación -->
        <div class="bg-white rounded-3xl p-8 shadow-xl border border-lear-gray-100">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-16 h-16 bg-gradient-to-br from-lear-secondary to-lear-accent rounded-2xl flex items-center justify-center shadow-lg">
              <svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <h2 class="text-2xl font-bold text-lear-gray-900">Nuestra Ubicación</h2>
          </div>
          <div class="space-y-4">
            <div class="space-y-2">
              <p class="text-lear-gray-700 leading-relaxed">
                <span class="font-semibold text-lear-gray-900">{addressLines[0]}</span><br/>
                {addressLines[1]}<br/>
                {addressLines[2]}
              </p>
            </div>
            <div class="flex flex-col sm:flex-row gap-3">
              <button
                type="button"
                id="share-location"
                data-address={addressText}
                data-maps={mapsUrl}
              class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl font-semibold text-white bg-lear-primary hover:bg-lear-primary-dark transition-colors"
            >
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8l5-5 5 5M12 3v12" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13v5a3 3 0 003 3h8a3 3 0 003-3v-5" />
                </svg>
                Compartir dirección
              </button>
              <a
                href={mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl font-semibold text-lear-primary border-2 border-lear-primary hover:bg-lear-primary hover:text-white transition-colors"
              >
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21s-6-5.686-6-10a6 6 0 1112 0c0 4.314-6 10-6 10z" />
                  <circle cx="12" cy="11" r="2.5" stroke="currentColor" stroke-width="2" />
                </svg>
                Abrir en Google Maps
              </a>
            </div>
            <p id="share-status" class="text-xs text-lear-gray-500" aria-live="polite"></p>

            <!-- Contacto directo -->
            <div class="pt-4 mt-2 border-t border-lear-gray-100">
              <p class="text-sm font-semibold text-lear-gray-900 mb-3">¿Agendamos tu cita?</p>
              <div class="flex flex-col sm:flex-row gap-3">
                <a
                  href={whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl font-semibold text-white bg-[#25D366] hover:bg-[#20BA5A] transition-colors"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                  </svg>
                  WhatsApp
                </a>
                <a
                  href={`tel:${phoneTel}`}
                  class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl font-semibold text-lear-primary border-2 border-lear-primary hover:bg-lear-primary hover:text-white transition-colors"
                >
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  {phoneDisplay}
                </a>
              </div>
            </div>
            <div class="pt-2">
              <div class="rounded-xl overflow-hidden shadow-lg border border-lear-gray-200">
                <iframe
                  src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3600.003494366944!2d-103.44710772374648!3d25.538260517800364!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x868fdbdc319ac29d%3A0xb57555f99e1e4ed5!2sAv.%20Juarez%20368%2C%20Primero%20de%20Cobi%C3%A1n%20Centro%2C%2027000%20Torre%C3%B3n%2C%20Coah.!5e0!3m2!1sen!2smx!4v1764402168552!5m2!1sen!2smx"
                  width="100%"
                  height="300"
                  style="border:0;"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  class="w-full"
                ></iframe>
              </div>
              <p class="text-xs text-lear-gray-500 mt-3 text-center">
                Haz clic en el mapa para abrir en Google Maps
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const shareButton = document.getElementById('share-location');
    const status = document.getElementById('share-status');

    if (shareButton && status) {
      shareButton.addEventListener('click', async () => {
        const address = shareButton.getAttribute('data-address') || '';
        const maps = shareButton.getAttribute('data-maps') || '';
        const shareData = {
          title: 'LEAR - Ubicación',
          text: `Dirección: ${address}`,
          url: maps
        };

        try {
          if (navigator.share) {
            await navigator.share(shareData);
            status.textContent = '¡Dirección compartida!';
            return;
          }

          if (navigator.clipboard) {
            await navigator.clipboard.writeText(`${address} - ${maps}`);
            status.textContent = 'Dirección copiada al portapapeles.';
            return;
          }

          status.textContent = 'Copia manualmente la dirección desde el texto.';
        } catch (error) {
          status.textContent = 'No se pudo compartir. Intenta copiar la dirección.';
        }
      });
    }
  </script>
</Layout>
